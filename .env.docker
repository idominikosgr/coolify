# Coolify Docker Environment
# Copy this file to .env and customize as needed

# Application
APP_NAME=Coolify
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Application Key (will be auto-generated if empty)
APP_KEY=

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=coolify-db
DB_PORT=5432
DB_DATABASE=coolify
DB_USERNAME=coolify
DB_PASSWORD=coolify_secret

# Redis Configuration
REDIS_HOST=coolify-redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Cache and Session
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis

# Mail (disabled by default)
MAIL_MAILER=log
